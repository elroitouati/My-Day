diff --git a/scripts/test-sync.mjs b/scripts/test-sync.mjs
new file mode 100644
index 0000000..59ac2cf
--- /dev/null
+++ b/scripts/test-sync.mjs
@@ -0,0 +1,87 @@
+// בדיקות ללוגיקת הסנכרון עם My Day.
+// הרצה:  node scripts/test-sync.mjs
+import { mkdtempSync, readFileSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+const dir = mkdtempSync(join(tmpdir(), 'panmatz-sync-'));
+for (const f of ['date.js', 'fitness.js', 'syncRows.js']) {
+  const src = readFileSync(join('src/utils', f), 'utf8').replace(/from '\.\/(\w+)'/g, "from './$1.js'");
+  writeFileSync(join(dir, f), src);
+}
+const S = await import(join(dir, 'syncRows.js'));
+
+let pass = 0, fail = 0;
+const t = (name, fn) => {
+  try { fn(); console.log('  PASS ', name); pass++; }
+  catch (e) { console.log('  FAIL ', name, '->', e.message); fail++; }
+};
+const ok = (c, m) => { if (!c) throw new Error(m || 'assertion failed'); };
+
+const goal = (o = {}) => ({
+  id: 'pullups', name: 'מתח', tracking: 'measured', unit: 'חזרות', enabled: true,
+  start: 2, current: 5, final: 30, step: 1, lowerIsBetter: false, trainingDays: [0, 2], history: [], ...o,
+});
+const state = (o = {}) => ({ goals: [goal(), goal({ id: 'core', name: 'בטן', tracking: 'check', unit: '', trainingDays: [0] })], logs: {}, ...o });
+
+// 2026-10-25 = יום ראשון
+t('יעדי יום ראשון', () => {
+  const rows = S.rowsForDate(state(), '2026-10-25');
+  ok(rows.length === 2);
+  ok(rows[0].target === '5 חז׳', rows[0].target);
+  ok(rows[1].target === '');
+});
+t('יום שני בלי אימון', () => ok(S.rowsForDate(state(), '2026-10-26').length === 0));
+t('יעד כבוי לא נשלח', () => ok(S.rowsForDate(state({ goals: [goal({ enabled: false })] }), '2026-10-25').length === 0));
+t('זמן ריצה מעוצב', () => ok(S.goalTarget(goal({ unit: 'זמן', current: 580 })) === '9:40 דק׳'));
+
+t('diff: הכל חדש בפעם הראשונה', () => {
+  const cur = S.rowsForRange(state(), '2026-10-25', '2026-10-27');
+  ok(S.diffRows(cur, {}, '2026-10-25', '2026-10-25', '2026-10-27').length === 3);
+});
+t('diff: אין שינוי = אין שליחה', () => {
+  const cur = S.rowsForRange(state(), '2026-10-25', '2026-10-27');
+  ok(S.diffRows(cur, { ...cur }, '2026-10-25', '2026-10-25', '2026-10-27').length === 0);
+});
+t('diff: סימון נשלח', () => {
+  const before = S.rowsForRange(state(), '2026-10-25', '2026-10-25');
+  const after = S.rowsForRange(state({ logs: { '2026-10-25': { trained: true, goals: { pullups: { done: true } } } } }), '2026-10-25', '2026-10-25');
+  const d = S.diffRows(after, before, '2026-10-25', '2026-10-25', '2026-10-25');
+  ok(d.length === 1 && d[0].goal_id === 'pullups' && d[0].done === true);
+});
+t('diff: יעד שכובה היום → deleted, אבל לא בימים שעברו', () => {
+  const pushed = {
+    ...S.rowsForRange(state(), '2026-10-18', '2026-10-18'),
+    ...S.rowsForRange(state(), '2026-10-25', '2026-10-25'),
+  };
+  const after = state({ goals: [goal()] });
+  const cur = { ...S.rowsForRange(after, '2026-10-18', '2026-10-18'), ...S.rowsForRange(after, '2026-10-25', '2026-10-25') };
+  const d = S.diffRows(cur, pushed, '2026-10-25', '2026-10-18', '2026-10-25');
+  ok(d.length === 1 && d[0].deleted && d[0].date === '2026-10-25' && d[0].goal_id === 'core', JSON.stringify(d));
+});
+t('תור בלי כפילויות', () => {
+  let q = [];
+  q = S.enqueue(q, { date: 'd', goal_id: 'g', done: true });
+  q = S.enqueue(q, { date: 'd', goal_id: 'g', done: false });
+  ok(q.length === 1 && q[0].done === false);
+});
+t('applyDone מסמן יעד נמדד עם הערך הנוכחי', () => {
+  const s = S.applyDone(state(), '2026-10-25', 'pullups', true);
+  ok(s.logs['2026-10-25'].goals.pullups.done === true);
+  ok(s.logs['2026-10-25'].goals.pullups.value === 5);
+  ok(s.logs['2026-10-25'].trained === true);
+  ok(s.goals[0].history.length === 1);
+});
+t('applyDone ביטול', () => {
+  const s1 = S.applyDone(state(), '2026-10-25', 'core', true);
+  const s2 = S.applyDone(s1, '2026-10-25', 'core', false);
+  ok(!s2.logs['2026-10-25'].goals.core && s2.logs['2026-10-25'].trained === false);
+});
+t('applyDone ללא שינוי מחזיר את אותו אובייקט (בלי רינדור מיותר)', () => {
+  const s = state();
+  ok(S.applyDone(s, '2026-10-25', 'core', false) === s);
+  ok(S.applyDone(s, '2026-10-25', 'nope', true) === s);
+});
+
+console.log(`\n${pass} passed, ${fail} failed`);
+process.exit(fail ? 1 : 0);
diff --git a/src/components/SyncSection.js b/src/components/SyncSection.js
new file mode 100644
index 0000000..07f79fc
--- /dev/null
+++ b/src/components/SyncSection.js
@@ -0,0 +1,168 @@
+import React, { useEffect, useState } from 'react';
+import { View, Text, Alert, ActivityIndicator, StyleSheet } from 'react-native';
+import { Ionicons } from '@expo/vector-icons';
+import { Section, Row } from './Group';
+import Input from './Input';
+import Button from './Button';
+import { colors, space } from '../design/tokens';
+import { text } from '../design/typography';
+import { ltr } from '../design/rtl';
+import { useApp } from '../context/AppContext';
+import { supabaseConfigured, authErrorText } from '../sync/supabase';
+import {
+  getSyncStatus,
+  onSyncStatus,
+  syncNow,
+  signIn,
+  signUp,
+  signOut,
+  backupToCloud,
+  fetchBackup,
+  lastBackupTime,
+} from '../sync/panmatzSync';
+import { formatHebDate, dayKey } from '../utils/date';
+
+// ============================================================================
+//  סנכרון עם My Day + גיבוי לענן. תוספת בלבד — בלי התחברות הכל נשאר מקומי.
+// ============================================================================
+
+const when = (iso) => {
+  if (!iso) return null;
+  const d = new Date(iso);
+  const hm = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
+  return `${formatHebDate(dayKey(d))} · ${hm}`;
+};
+
+export default function SyncSection() {
+  const { state, restoreState } = useApp();
+  const [status, setStatus] = useState(getSyncStatus());
+  const [email, setEmail] = useState('');
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState(null);
+  const [msg, setMsg] = useState(null);
+  const [backupAt, setBackupAt] = useState(null);
+
+  useEffect(() => onSyncStatus(setStatus), []);
+  useEffect(() => {
+    if (status.user) lastBackupTime().then(setBackupAt).catch(() => {});
+  }, [status.user]);
+
+  if (!supabaseConfigured) return null; // בלי מפתחות — המסך נראה בדיוק כמו קודם
+
+  const run = (name, fn) => async () => {
+    setBusy(name);
+    setMsg(null);
+    try {
+      await fn();
+    } catch (e) {
+      setMsg({ error: true, text: authErrorText(e) });
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  if (!status.user) {
+    return (
+      <Section
+        title="סנכרון עם My Day"
+        footer="התחברות חד-פעמית. אותו חשבון בשתי האפליקציות — ואז אימון שסומן כאן מסומן גם ב-My Day, ולהפך."
+      >
+        <Row>
+          <View style={styles.form}>
+            <Input value={email} onChangeText={setEmail} placeholder="אימייל" keyboardType="email-address" autoCapitalize="none" autoComplete="email" />
+            <Input value={password} onChangeText={setPassword} placeholder="סיסמה (לפחות 6 תווים)" secureTextEntry autoCapitalize="none" />
+            {msg ? <Text style={[text.sub, msg.error ? styles.err : styles.ok]}>{msg.text}</Text> : null}
+            <Button
+              variant="primary"
+              label={busy === 'in' ? 'מתחבר…' : 'התחברות'}
+              disabled={!!busy || !email || !password}
+              onPress={run('in', () => signIn(email, password))}
+            />
+            <Button
+              label="אין לי חשבון — הרשמה"
+              disabled={!!busy || !email || password.length < 6}
+              onPress={run('up', async () => {
+                const ready = await signUp(email, password);
+                if (!ready) setMsg({ text: 'נשלח אימייל אישור. אשר אותו ואז לחץ "התחברות".' });
+              })}
+            />
+          </View>
+        </Row>
+      </Section>
+    );
+  }
+
+  const restore = () =>
+    Alert.alert(
+      'לשחזר מהגיבוי בענן?',
+      'כל הנתונים באפליקציה יוחלפו בנתונים מהגיבוי האחרון. אי אפשר לבטל.',
+      [
+        { text: 'ביטול', style: 'cancel' },
+        {
+          text: 'שחזור',
+          style: 'destructive',
+          onPress: run('restore', async () => {
+            const backup = await fetchBackup();
+            if (!backup?.state) {
+              setMsg({ error: true, text: 'עדיין אין גיבוי בענן' });
+              return;
+            }
+            restoreState(backup.state);
+            setMsg({ text: 'הנתונים שוחזרו מהגיבוי' });
+          }),
+        },
+      ]
+    );
+
+  return (
+    <Section
+      title="סנכרון עם My Day"
+      footer={msg?.text || (status.error ? `הסנכרון האחרון נכשל (${authErrorText(status.error)}). השינויים שמורים וישלחו כשיחזור החיבור.` : 'אימונים ויעדי היום מופיעים ב-My Day, וסימון בכל צד מתעדכן בשני.')}
+    >
+      <Row
+        title="מחובר"
+        subtitle={status.user.email}
+        leading={<Ionicons name="cloud-done-outline" size={22} color={colors.gold} />}
+        value={status.lastSync ? ltr(when(status.lastSync).split(' · ')[1]) : null}
+      />
+      <Row
+        title="סנכרון עכשיו"
+        leading={<Ionicons name="sync-outline" size={22} color={colors.ink2} />}
+        trailing={busy === 'sync' ? <ActivityIndicator color={colors.gold} /> : null}
+        onPress={run('sync', async () => {
+          await syncNow();
+          setMsg({ text: 'מסונכרן ✓' });
+        })}
+      />
+      <Row
+        title="גיבוי מלא לענן"
+        subtitle={backupAt ? `גיבוי אחרון: ${when(backupAt)}` : 'עוד לא נשמר גיבוי'}
+        leading={<Ionicons name="cloud-upload-outline" size={22} color={colors.ink2} />}
+        trailing={busy === 'backup' ? <ActivityIndicator color={colors.gold} /> : null}
+        onPress={run('backup', async () => {
+          const at = await backupToCloud(state);
+          setBackupAt(at);
+          setMsg({ text: 'כל הנתונים גובו לענן ✓' });
+        })}
+      />
+      <Row
+        title="שחזור מהגיבוי"
+        leading={<Ionicons name="cloud-download-outline" size={22} color={colors.ink2} />}
+        trailing={busy === 'restore' ? <ActivityIndicator color={colors.gold} /> : null}
+        onPress={restore}
+      />
+      <Row
+        title="התנתקות"
+        leading={<Ionicons name="log-out-outline" size={22} color={colors.red} />}
+        onPress={run('out', () => signOut())}
+      />
+    </Section>
+  );
+}
+
+const styles = StyleSheet.create({
+  form: { gap: space[3], paddingVertical: space[2] },
+  err: { color: colors.red },
+  ok: { color: colors.gold },
+});
+
